Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 default

<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType text/css .css
    AddType application/xml .xml
    AddType text/plain .txt
    AddCharset UTF-8 .html .css .js .mjs .json .xml .txt
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|jpe?g|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_STATUS} == 200"
    </FilesMatch>
</IfModule>

RewriteEngine On

# Gateway dinâmico do sitemap: entrega o XML oficial atualizado da API
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Redirecionamento amigável para o feed oficial do Google Merchant Center
RewriteRule ^feed/google-merchant\.xml$ https://api.misturafeminina.com.br/merchant-feed.xml [R=301,L]
RewriteRule ^merchant-feed\.xml$ https://api.misturafeminina.com.br/merchant-feed.xml [R=301,L]

# Serve existing files and directories before applying the SPA fallback.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# Missing assets must return 404, never the application's HTML.
RewriteRule ^assets(?:/|$) - [R=404,END]
RewriteRule \.[^/]+$ - [R=404,END]

# Browser routes are resolved by the frontend router.
RewriteRule ^ index.html [END]
