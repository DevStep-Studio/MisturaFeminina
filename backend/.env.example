APP_NAME="Mistura Feminina Cosméticos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mistura_feminina
DB_USERNAME=mistura_user
DB_PASSWORD=change_me_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:3100,127.0.0.1:3100

CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=no-reply@misturafeminina.local
MAIL_FROM_NAME="Mistura Feminina Cosméticos"

# Frete (Melhor Envio Sandbox/Produção + CEP de origem)
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_TOKEN=
STORE_ORIGIN_CEP=01001000

SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=

PAYMENTS_DEFAULT_PROVIDER=mercadopago
PAYMENTS_WEBHOOK_BASE_URL=
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
ASAAS_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
CORREIOS_ENABLED=false
CORREIOS_ENVIRONMENT=sandbox
CORREIOS_USERNAME=
CORREIOS_API_PASSWORD=
CORREIOS_POSTING_CARD=
CORREIOS_CONTRACT=
CORREIOS_REGIONAL=
CORREIOS_ORIGIN_ZIP=
